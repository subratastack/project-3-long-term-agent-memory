# PostgreSQL is the authoritative memory store.
POSTGRES_DB=agent_memory
POSTGRES_USER=agent_memory
POSTGRES_PASSWORD=agent_memory_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agent_memory:agent_memory_local@localhost:5432/agent_memory
# Integration tests create and drop every table, so they use their own database.
# Defaults to DATABASE_URL's database name + "_test" (created automatically).
# TEST_DATABASE_URL=postgresql+psycopg://agent_memory:agent_memory_local@localhost:5432/agent_memory_test

# Local embedding and reranking models.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Torch device for both models: cuda, cuda:1, cpu, mps. Unset = GPU if available, else CPU.
MODEL_DEVICE=

# LLM-backed extraction is introduced after deterministic storage and policy.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Retrieval limits. Ranking never overrides tenant/trust/time filters.
RETRIEVAL_LEXICAL_LIMIT=50
RETRIEVAL_SEMANTIC_LIMIT=50
RETRIEVAL_RERANK_LIMIT=30
RETRIEVAL_FINAL_LIMIT=10
MEMORY_CONTEXT_TOKEN_BUDGET=2000

# Hybrid weights are explicit and must be benchmarked before production use.
HYBRID_LEXICAL_WEIGHT=0.5
HYBRID_SEMANTIC_WEIGHT=0.5

# Runtime and telemetry.
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=agent-memory-service
OTEL_EXPORTER_OTLP_ENDPOINT=

# Hugging Face API key for model downloads. Optional if you have a local cache.
HUGGINGFACE_API_KEY=